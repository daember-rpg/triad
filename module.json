{
  "id": "triad",
  "title": "Triad",
  "description": "A left-side play tray for Pathfinder 2e: strikes with MAP, spells and slots, actions, consumables, skills, conditions and a three-action turn tracker — without opening the character sheet.",
  "version": "0.7.3-alpha",
  "authors": [
    {
      "name": "Hello Melo Design"
    }
  ],
  "url": "https://github.com/daember-rpg/triad",
  "manifest": "https://github.com/daember-rpg/triad/releases/latest/download/module.json",
  "download": "https://github.com/daember-rpg/triad/releases/download/v0.7.3-alpha/triad.zip",
  "bugs": "https://github.com/daember-rpg/triad/issues",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "7.0.0"
        }
      }
